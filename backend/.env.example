# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=paper_trader

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemma-4-31b-it
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Finnhub fallback news
FINNHUB_API_KEY=your_finnhub_api_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Dashboard URL for Telegram links
DASHBOARD_URL=http://127.0.0.1:5173

# NewsData.io (macro news)
NEWSDATA_API_KEY=your_newsdata_api_key_here

# Agent Config
INITIAL_BALANCE=1000000.0
MAX_POSITION_PCT=0.20
WATCHLIST=NIFTY500
MAX_CANDIDATES_FOR_AI=40
RUN_ANALYSIS_ON_STARTUP=true

# Risk Management
STOP_LOSS_PCT=0.05
TRAILING_STOP_ACTIVATION_PCT=0.15
TRAILING_STOP_DISTANCE_PCT=0.10
TRAILING_STOP_STRICT_PCT=0.06
MAX_DRAWDOWN_PCT=0.15
MAX_SECTOR_STOCKS=3

# Capital Allocation
MAX_OPEN_POSITIONS=15
MAX_SINGLE_TRADE_PCT=0.10
MIN_CASH_RESERVE_PCT=0.05

# Batch Decision Thresholds
SCORE_STRONG_HOLD=0.48
SCORE_WEAK_HOLD=0.35

# Analysis Weights (must sum to 1.0)
WEIGHT_GEMINI=0.50
WEIGHT_ML=0.15
WEIGHT_NEWS=0.20
WEIGHT_RISK=0.15

# Max Buys Per Cycle
MAX_BUYS_PER_CYCLE=3
MAX_BUYS_PER_CYCLE_CAUTIOUS=2

# Underperformer Detection
UNDERPERFORMER_DAYS=10

# Cautious Regime
CAUTIOUS_BUY_SCORE_THRESHOLD=0.68
CAUTIOUS_TRAILING_STOP_PCT=0.07

# ── Dhan Broker API ──────────────────────────────────────────────
DHAN_CLIENT_ID=your_dhan_client_id_here
DHAN_PIN=your_dhan_pin_here
DHAN_TOTP_SECRET=your_dhan_totp_secret_here
DHAN_TRADING_ENABLED=true
LIVE_CAPITAL_CAP=0
DHAN_ACCESS_TOKEN=your_dhan_access_token_here

# ── Trading Mode ─────────────────────────────────────────────────
# "paper" = virtual money (no real trades)
# "live"  = real money via Dhan API
TRADING_MODE=paper

# ── Global Kill Switch ───────────────────────────────────────────
# When true: NO new buys in either mode, only sells allowed
KILL_SWITCH_ENABLED=false

# Groq API (PRIMARY ANALYST: compound first, openai/gpt-oss-120b fallback)
GROQ_API_KEY=your_groq_api_key_here
GROQ_COMPOUND_MODEL=groq/compound
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
